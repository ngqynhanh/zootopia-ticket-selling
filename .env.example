# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=zoopass
POSTGRES_USER=zoopass
POSTGRES_PASSWORD=change-me

# --- Backend ---
# dev = detailed errors + SQL debug logs, prod = generic errors
SPRING_PROFILES_ACTIVE=dev
# Used when running the backend outside Docker (mvn spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/zoopass
DB_USERNAME=zoopass
DB_PASSWORD=change-me
# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# --- Added in later weeks ---
# JWT_SECRET=
# MAIL_HOST= / MAIL_USERNAME= / MAIL_PASSWORD=
# VNPAY_TMN_CODE= / VNPAY_HASH_SECRET=
# CLOUDINARY_URL=
