# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=zoopass
POSTGRES_USER=zoopass
POSTGRES_PASSWORD=change-me

# --- Backend ---
# dev = detailed errors + SQL debug logs, prod = generic errors
SPRING_PROFILES_ACTIVE=dev
# Used when running the backend outside Docker (mvn spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/zoopass
DB_USERNAME=zoopass
DB_PASSWORD=change-me
# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# --- Authentication ---
# Required outside the dev profile: at least 32 random characters
# (e.g. generate with: openssl rand -base64 48)
JWT_SECRET=
# Base URL of the React app, used in verification / reset email links
FRONTEND_URL=http://localhost:5173
# Production with frontend and API on different domains: true / None
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# --- Email (optional; without SPRING_MAIL_HOST emails are written to the log) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=ZooPass <no-reply@zoopass.test>

# --- Added in later weeks ---
# VNPAY_TMN_CODE= / VNPAY_HASH_SECRET=
# CLOUDINARY_URL=
